{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blast-gb:schema:suite:1",
  "title": "Blast GB test suite version 1",
  "description": "Named independent emulator cases. Paths are relative to the suite directory and remain inside it. All cases and aggregate budgets are validated before building or allocating a session.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "rom"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Unique case name." },
          "rom": { "$ref": "#/$defs/path" },
          "assert": { "$ref": "#/$defs/path" },
          "script": { "$ref": "#/$defs/path" },
          "frames": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 60 },
          "maxInstructions": { "type": "integer", "minimum": 1, "maximum": 10000000, "default": 1000000 },
          "breakpoint": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "buttons": {
            "type": "array",
            "maxItems": 8,
            "items": { "enum": ["up", "down", "left", "right", "A", "B", "start", "select"] }
          }
        },
        "oneOf": [
          { "required": ["assert"], "not": { "required": ["script"] } },
          {
            "required": ["script"],
            "not": { "anyOf": [{ "required": ["assert"] }, { "required": ["frames"] }, { "required": ["maxInstructions"] }, { "required": ["breakpoint"] }, { "required": ["buttons"] }] }
          }
        ]
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "description": "Relative path inside the suite directory; traversal, absolute paths, and symlinks are rejected." }
  }
}
