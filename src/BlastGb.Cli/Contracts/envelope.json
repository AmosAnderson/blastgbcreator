{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blast-gb:schema:envelope:1",
  "title": "Blast GB CLI result envelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {},
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "data"
        ]
      },
      "else": {
        "required": [
          "error"
        ]
      }
    }
  ]
}
