{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blast-gb:schema:assertions:1",
  "title": "Mapped CPU-memory, register, and framebuffer assertions",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "memory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "address",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "address": {
            "oneOf": [
              {
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              {
                "minLength": 1,
                "maxLength": 1024,
                "type": "string"
              }
            ],
            "description": "Mapped CPU address or label resolved by CLI --symbols. Symbol labels must be bank-0 ROM0, WRAM0 or HRAM; constants and banked regions are rejected."
          },
          "bytes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 1,
            "maxItems": 65536
          }
        }
      }
    },
    "registers": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(?:[aA]|[fF])$": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "^(?:[aA][fF]|[bB][cC]|[dD][eE]|[hH][lL]|[sS][pP])$": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "^[pP][cC]$": {
          "oneOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "minLength": 1,
              "maxLength": 1024,
              "type": "string"
            }
          ],
          "description": "Mapped CPU address or label resolved by CLI --symbols. Symbol labels must be bank-0 ROM0, WRAM0 or HRAM; constants and banked regions are rejected."
        }
      }
    },
    "framebufferSha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "SHA-256 of the 160 by 144 RGBA framebuffer, normalized to lowercase."
    }
  },
  "anyOf": [
    {
      "required": [
        "memory"
      ],
      "properties": {
        "memory": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "registers"
      ],
      "properties": {
        "registers": {
          "minProperties": 1
        }
      }
    },
    {
      "required": [
        "framebufferSha256"
      ]
    }
  ]
}
