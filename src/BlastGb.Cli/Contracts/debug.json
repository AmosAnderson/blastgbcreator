{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blast-gb:schema:debug:1",
  "title": "Bounded debugger script",
  "type": "object",
  "required": [
    "version",
    "commands"
  ],
  "additionalProperties": false,
  "description": "Aggregate budgets: at most 3600 frames, 1000000 step/run instructions, and 1048576 read/write/assert bytes. Address ranges must fit mapped memory. Duplicate breakpoint addresses are normalized.",
  "properties": {
    "version": {
      "const": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "step"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "frame"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "address"
            ],
            "properties": {
              "op": {
                "const": "read"
              },
              "address": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "address",
              "bytes"
            ],
            "properties": {
              "op": {
                "const": "write"
              },
              "address": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "bytes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 1,
                "maxItems": 65536
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "addresses"
            ],
            "properties": {
              "op": {
                "const": "breakpoints"
              },
              "addresses": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "run"
              },
              "frames": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "maxInstructions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "assert"
              },
              "memory": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "address",
                    "bytes"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "address": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    },
                    "bytes": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "minItems": 1,
                      "maxItems": 65536
                    }
                  }
                }
              },
              "registers": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^(?:[aA]|[fF])$": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "^(?:[aA][fF]|[bB][cC]|[dD][eE]|[hH][lL]|[sS][pP]|[pP][cC])$": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
                }
              }
            },
            "anyOf": [
              {
                "required": [
                  "memory"
                ],
                "properties": {
                  "memory": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "registers"
                ],
                "properties": {
                  "registers": {
                    "minProperties": 1
                  }
                }
              }
            ]
          }
        ]
      }
    }
  }
}
