{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blast-gb:schema:debug:1",
  "title": "Bounded debugger script",
  "type": "object",
  "required": [
    "version",
    "commands"
  ],
  "additionalProperties": false,
  "description": "Aggregate budgets: at most 3600 frames, 1000000 step/run/until instructions, 1048576 read/write/assert/predicate bytes, and 32 captures. Until predicates reserve their worst-case repeated memory reads. Address ranges must fit mapped memory. Duplicate breakpoint addresses are normalized.",
  "properties": {
    "version": {
      "const": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "step"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "frame"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "address"
            ],
            "properties": {
              "op": {
                "const": "read"
              },
              "address": {
                "oneOf": [
                  {
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "minLength": 1,
                    "maxLength": 1024,
                    "type": "string"
                  }
                ],
                "description": "Mapped CPU address or label resolved by CLI --symbols. Symbol labels must be bank-0 ROM0, WRAM0 or HRAM; constants and banked regions are rejected."
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "address",
              "bytes"
            ],
            "properties": {
              "op": {
                "const": "write"
              },
              "address": {
                "oneOf": [
                  {
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "minLength": 1,
                    "maxLength": 1024,
                    "type": "string"
                  }
                ],
                "description": "Mapped CPU address or label resolved by CLI --symbols. Symbol labels must be bank-0 ROM0, WRAM0 or HRAM; constants and banked regions are rejected."
              },
              "bytes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 1,
                "maxItems": 65536
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "addresses"
            ],
            "properties": {
              "op": {
                "const": "breakpoints"
              },
              "addresses": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "oneOf": [
                    {
                      "maximum": 65535,
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "minLength": 1,
                      "maxLength": 1024,
                      "type": "string"
                    }
                  ],
                  "description": "Mapped CPU address or label resolved by CLI --symbols. Symbol labels must be bank-0 ROM0, WRAM0 or HRAM; constants and banked regions are rejected."
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "run"
              },
              "frames": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "maxInstructions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "assert"
              },
              "memory": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "address",
                    "bytes"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "address": {
                      "oneOf": [
                        {
                          "maximum": 65535,
                          "minimum": 0,
                          "type": "integer"
                        },
                        {
                          "minLength": 1,
                          "maxLength": 1024,
                          "type": "string"
                        }
                      ],
                      "description": "Mapped CPU address or label resolved by CLI --symbols. Symbol labels must be bank-0 ROM0, WRAM0 or HRAM; constants and banked regions are rejected."
                    },
                    "bytes": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "minItems": 1,
                      "maxItems": 65536
                    }
                  }
                }
              },
              "registers": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^(?:[aA]|[fF])$": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "^(?:[aA][fF]|[bB][cC]|[dD][eE]|[hH][lL]|[sS][pP])$": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "^[pP][cC]$": {
                    "oneOf": [
                      {
                        "maximum": 65535,
                        "minimum": 0,
                        "type": "integer"
                      },
                      {
                        "minLength": 1,
                        "maxLength": 1024,
                        "type": "string"
                      }
                    ],
                    "description": "Mapped CPU address or label resolved by CLI --symbols. Symbol labels must be bank-0 ROM0, WRAM0 or HRAM; constants and banked regions are rejected."
                  }
                }
              },
              "framebufferSha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$",
                "description": "SHA-256 of the 160 by 144 RGBA framebuffer, normalized to lowercase."
              }
            },
            "anyOf": [
              {
                "required": [
                  "memory"
                ],
                "properties": {
                  "memory": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "registers"
                ],
                "properties": {
                  "registers": {
                    "minProperties": 1
                  }
                }
              },
              {
                "required": [
                  "framebufferSha256"
                ]
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "pressed"
            ],
            "properties": {
              "op": {
                "const": "buttons"
              },
              "pressed": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down",
                    "left",
                    "right",
                    "A",
                    "B",
                    "start",
                    "select"
                  ]
                }
              }
            },
            "description": "Replace the complete set of held buttons; an empty array releases all buttons."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "until"
              },
              "memory": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "address",
                    "bytes"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "address": {
                      "oneOf": [
                        {
                          "maximum": 65535,
                          "minimum": 0,
                          "type": "integer"
                        },
                        {
                          "minLength": 1,
                          "maxLength": 1024,
                          "type": "string"
                        }
                      ],
                      "description": "Mapped CPU address or label resolved by CLI --symbols. Symbol labels must be bank-0 ROM0, WRAM0 or HRAM; constants and banked regions are rejected."
                    },
                    "bytes": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "minItems": 1,
                      "maxItems": 65536
                    }
                  }
                }
              },
              "registers": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^(?:[aA]|[fF])$": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "^(?:[aA][fF]|[bB][cC]|[dD][eE]|[hH][lL]|[sS][pP])$": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "^[pP][cC]$": {
                    "oneOf": [
                      {
                        "maximum": 65535,
                        "minimum": 0,
                        "type": "integer"
                      },
                      {
                        "minLength": 1,
                        "maxLength": 1024,
                        "type": "string"
                      }
                    ],
                    "description": "Mapped CPU address or label resolved by CLI --symbols. Symbol labels must be bank-0 ROM0, WRAM0 or HRAM; constants and banked regions are rejected."
                  }
                }
              },
              "frames": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600,
                "default": 60
              },
              "maxInstructions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000,
                "default": 100000
              }
            },
            "anyOf": [
              {
                "required": [
                  "memory"
                ],
                "properties": {
                  "memory": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "registers"
                ],
                "properties": {
                  "registers": {
                    "minProperties": 1
                  }
                }
              }
            ],
            "description": "Wait for all memory/register conditions, checking initially and after each advancing instruction. An unmet condition stops the script with assertionsPassed false. Predicate memory reserves (maxInstructions + 2) times the listed bytes, including final evidence."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "name"
            ],
            "properties": {
              "op": {
                "const": "capture"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                "not": {
                  "anyOf": [
                    {
                      "pattern": "^(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])$"
                    },
                    {
                      "pattern": "^[fF][aA][iI][lL][uU][rR][eE]-[0-9]+$"
                    }
                  ]
                }
              }
            },
            "description": "Capture named framebuffer hash evidence and pixels. Names are unique ignoring case. At most 32 captures per script; failure-N names are reserved."
          }
        ]
      }
    }
  }
}
