{
  "name": "Blast GB Tools",
  "version": "0.4.0",
  "schemaVersion": 1,
  "commands": [
    "rom info",
    "rom verify",
    "rom diff",
    "rom patch",
    "asm compile",
    "asm decompile",
    "project init",
    "project import",
    "project resolve",
    "build",
    "run",
    "test",
    "debug",
    "capabilities",
    "schema",
    "version",
    "mcp serve",
    "init",
    "import",
    "inspect",
    "verify",
    "disassemble",
    "patch",
    "rom patch-create",
    "asm symbols",
    "game validate",
    "game export",
    "asset convert",
    "asset encode",
    "asset decode",
    "project status",
    "project test"
  ],
  "commandDefinitions": [
    {
      "name": "rom info",
      "description": "Inspect cartridge metadata and checksums.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": [],
      "aliases": [
        "inspect"
      ]
    },
    {
      "name": "rom verify",
      "description": "Validate cartridge size, logo, and checksums.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": [],
      "aliases": [
        "verify"
      ]
    },
    {
      "name": "rom diff",
      "description": "Compare two ROMs with bounded change previews.",
      "arguments": [
        {
          "name": "before",
          "type": "path",
          "required": true,
          "role": "input"
        },
        {
          "name": "after",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": []
    },
    {
      "name": "rom patch",
      "description": "Apply expected-byte-guarded edits to a separate cartridge.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        },
        {
          "name": "patches",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "output",
        "overwrite",
        "fix-checksums",
        "allow-unguarded",
        "json",
        "help"
      ],
      "sideEffects": [
        "write-output-rom"
      ],
      "aliases": [
        "patch"
      ]
    },
    {
      "name": "asm compile",
      "description": "Assemble RGBDS source and emit ROM, symbols, and map.",
      "arguments": [
        {
          "name": "source",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "output",
        "overwrite",
        "fix-checksums",
        "json",
        "help",
        "receipt"
      ],
      "sideEffects": [
        "execute-rgbds",
        "write-build-artifacts"
      ]
    },
    {
      "name": "asm decompile",
      "description": "Decode candidate instructions or export byte-exact RGBDS data.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "output",
        "overwrite",
        "offset",
        "count",
        "json",
        "help",
        "symbols",
        "symbol"
      ],
      "sideEffects": [
        "write-output-if-requested"
      ],
      "aliases": [
        "disassemble"
      ]
    },
    {
      "name": "project init",
      "description": "Create editable source or a built-in GameSpec project.",
      "arguments": [
        {
          "name": "directory",
          "type": "path",
          "required": true,
          "role": "output"
        }
      ],
      "options": [
        "name",
        "kind",
        "json",
        "help"
      ],
      "sideEffects": [
        "create-project-directory"
      ],
      "aliases": [
        "init"
      ]
    },
    {
      "name": "project import",
      "description": "Preserve a cartridge and export a byte-exact source project.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        },
        {
          "name": "directory",
          "type": "path",
          "required": true,
          "role": "output"
        }
      ],
      "options": [
        "name",
        "json",
        "help"
      ],
      "sideEffects": [
        "create-project-directory"
      ],
      "aliases": [
        "import"
      ]
    },
    {
      "name": "project resolve",
      "description": "Validate a project and resolve inputs and outputs without writing.",
      "arguments": [
        {
          "name": "project",
          "type": "path",
          "required": false,
          "role": "input"
        }
      ],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": [],
      "aliases": [
        "project info"
      ]
    },
    {
      "name": "build",
      "description": "Build a project, RGBDS source file, or GameSpec JSON.",
      "arguments": [
        {
          "name": "project",
          "type": "path",
          "required": false,
          "role": "input"
        }
      ],
      "options": [
        "output",
        "overwrite",
        "fix-checksums",
        "json",
        "help",
        "receipt"
      ],
      "sideEffects": [
        "execute-rgbds-for-assembly",
        "write-build-artifacts"
      ]
    },
    {
      "name": "run",
      "description": "Execute a cartridge with bounded frames and optional assertions.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "frames",
        "memory",
        "assert",
        "buttons",
        "breakpoint",
        "max-instructions",
        "json",
        "help",
        "symbols",
        "screenshot",
        "overwrite"
      ],
      "sideEffects": [
        "execute-emulator",
        "write-screenshot-if-requested"
      ]
    },
    {
      "name": "test",
      "description": "Execute a cartridge and require an assertion file.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "frames",
        "memory",
        "assert",
        "buttons",
        "breakpoint",
        "max-instructions",
        "json",
        "help",
        "symbols",
        "screenshot",
        "overwrite"
      ],
      "sideEffects": [
        "execute-emulator",
        "write-screenshot-if-requested"
      ]
    },
    {
      "name": "debug",
      "description": "Execute a deterministic debugger command script.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "script",
        "json",
        "help",
        "symbols",
        "screenshot",
        "overwrite",
        "capture-dir"
      ],
      "sideEffects": [
        "execute-emulator",
        "write-runtime-bus-if-requested",
        "write-screenshot-if-requested",
        "write-captures-if-requested"
      ]
    },
    {
      "name": "capabilities",
      "description": "Discover versioned commands and contracts.",
      "arguments": [],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": []
    },
    {
      "name": "schema",
      "description": "List contracts or retrieve a JSON Schema by name.",
      "arguments": [
        {
          "name": "name",
          "type": "string",
          "required": false
        }
      ],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": []
    },
    {
      "name": "version",
      "description": "Print the installed toolkit version.",
      "arguments": [],
      "options": [
        "version",
        "json",
        "help"
      ],
      "sideEffects": [],
      "aliases": [
        "--version"
      ]
    },
    {
      "name": "mcp serve",
      "description": "Serve local command utilities over MCP stdio.",
      "arguments": [],
      "options": [
        "help"
      ],
      "sideEffects": [
        "serve-stdio"
      ]
    },
    {
      "arguments": [
        {
          "name": "before",
          "type": "path",
          "required": true,
          "role": "input"
        },
        {
          "name": "after",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "name": "rom patch-create",
      "description": "Create guarded patches that reproduce an edited equal-length ROM.",
      "options": [
        "output",
        "overwrite",
        "json",
        "help"
      ],
      "sideEffects": [
        "write-patch-file"
      ]
    },
    {
      "arguments": [
        {
          "name": "symbols",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "name": "asm symbols",
      "description": "Inspect RGBDS labels, banks, physical ROM offsets, and exported constants.",
      "options": [
        "symbol",
        "json",
        "help"
      ],
      "sideEffects": []
    },
    {
      "arguments": [
        {
          "name": "game",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "name": "game validate",
      "description": "Validate a collection-game GameSpec without building or writing.",
      "options": [
        "json",
        "help"
      ],
      "sideEffects": []
    },
    {
      "arguments": [
        {
          "name": "game",
          "type": "path",
          "required": true,
          "role": "input"
        },
        {
          "name": "directory",
          "type": "path",
          "required": true,
          "role": "output"
        }
      ],
      "name": "game export",
      "description": "Export a customized GameSpec into a new editable source project.",
      "options": [
        "name",
        "json",
        "help"
      ],
      "sideEffects": [
        "create-project-directory"
      ]
    },
    {
      "arguments": [
        {
          "name": "image",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "name": "asset convert",
      "description": "Convert PNG graphics into Game Boy tiles and optional tilemap, CGB palette and attributes using rgbgfx.",
      "options": [
        "output",
        "tilemap",
        "palette",
        "attrmap",
        "overwrite",
        "json",
        "help"
      ],
      "sideEffects": [
        "execute-rgbds",
        "write-graphics-assets"
      ]
    },
    {
      "arguments": [
        {
          "name": "pixels",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "name": "asset encode",
      "description": "Encode a tile-major JSON array of palette indices 0-3 into planar 2bpp tiles.",
      "options": [
        "output",
        "overwrite",
        "json",
        "help"
      ],
      "sideEffects": [
        "write-graphics-assets"
      ]
    },
    {
      "arguments": [
        {
          "name": "tiles",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "name": "asset decode",
      "description": "Decode planar 2bpp tiles into a numeric JSON pixel array.",
      "options": [
        "output",
        "overwrite",
        "json",
        "help"
      ],
      "sideEffects": [
        "write-graphics-assets"
      ]
    },
    {
      "arguments": [
        {
          "name": "project",
          "type": "path",
          "required": false,
          "role": "input"
        }
      ],
      "name": "project status",
      "description": "Check receipt input, output and tool hashes without writing or building.",
      "options": [
        "receipt",
        "json",
        "help"
      ],
      "sideEffects": []
    },
    {
      "arguments": [
        {
          "name": "project",
          "type": "path",
          "required": false,
          "role": "input"
        }
      ],
      "name": "project test",
      "description": "Validate and run named bounded tests with fresh sessions, optional one-time build, and atomic reports/captures.",
      "options": [
        "suite",
        "build",
        "overwrite",
        "report",
        "capture-dir",
        "symbols",
        "json",
        "help"
      ],
      "sideEffects": [
        "execute-emulator",
        "build-if-requested",
        "write-report-and-captures-if-requested"
      ]
    }
  ],
  "optionDefinitions": {
    "json": {
      "type": "boolean",
      "description": "Emit one versioned result envelope.",
      "default": false
    },
    "help": {
      "type": "boolean",
      "description": "Show command help.",
      "default": false
    },
    "version": {
      "type": "boolean",
      "description": "Print toolkit version."
    },
    "output": {
      "type": "path",
      "role": "output",
      "description": "Separate destination; never an input file."
    },
    "overwrite": {
      "type": "boolean",
      "default": false,
      "description": "Replace existing host outputs after validation."
    },
    "fix-checksums": {
      "type": "boolean",
      "default": false,
      "description": "Explicitly repair header/global checksums."
    },
    "allow-unguarded": {
      "type": "boolean",
      "default": false,
      "description": "Permit patch records without expected bytes."
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 256,
      "description": "Physical ROM byte offset."
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "default": 64,
      "description": "Maximum candidate instructions."
    },
    "name": {
      "type": "string",
      "description": "Project display name."
    },
    "kind": {
      "type": "string",
      "choices": [
        "source",
        "game"
      ],
      "default": "source"
    },
    "frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 60,
      "description": "70224-tick frame budgets."
    },
    "memory": {
      "type": "string",
      "description": "Mapped address:length ranges, or label:length with --symbols; at most 65536 bytes total."
    },
    "assert": {
      "type": "path",
      "role": "input",
      "schema": "assertions"
    },
    "script": {
      "type": "path",
      "role": "input",
      "schema": "debug"
    },
    "buttons": {
      "type": "string",
      "description": "Comma-separated buttons held during execution.",
      "choices": [
        "up",
        "down",
        "left",
        "right",
        "A",
        "B",
        "start",
        "select"
      ]
    },
    "breakpoint": {
      "type": "string",
      "description": "Mapped 16-bit CPU address (decimal or 0x hex), or a fixed-bank label with --symbols."
    },
    "max-instructions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000,
      "default": 1000000,
      "description": "Step budget while seeking a breakpoint."
    },
    "symbols": {
      "description": "RGBDS .sym file for resolving address labels.",
      "type": "path",
      "role": "input"
    },
    "suite": {
      "description": "Version-1 named project test suite; defaults to manifest tests or tests.json.",
      "type": "path",
      "role": "input"
    },
    "screenshot": {
      "description": "Final 160x144 RGBA PNG, including assertion failures.",
      "type": "path",
      "role": "output"
    },
    "capture-dir": {
      "description": "Directory for named debug/suite PNG captures.",
      "type": "path",
      "role": "output"
    },
    "report": {
      "description": "Structured JSON suite report.",
      "type": "path",
      "role": "output"
    },
    "tilemap": {
      "description": "Tile-index map from rgbgfx.",
      "type": "path",
      "role": "output"
    },
    "palette": {
      "description": "CGB RGB15 palette bytes from rgbgfx.",
      "type": "path",
      "role": "output"
    },
    "attrmap": {
      "description": "CGB attribute map from rgbgfx.",
      "type": "path",
      "role": "output"
    },
    "receipt": {
      "description": "Build receipt output, or receipt input for project status.",
      "type": "path"
    },
    "symbol": {
      "description": "Exact case-sensitive label name; disassembly requires a physical ROM label.",
      "type": "string"
    },
    "build": {
      "description": "Build once before running a validated project suite.",
      "type": "boolean",
      "default": false
    }
  },
  "requiredOptions": {
    "rom patch": [
      "output"
    ],
    "test": [
      "assert"
    ],
    "debug": [
      "script"
    ],
    "rom patch-create": [
      "output"
    ],
    "asset convert": [
      "output"
    ],
    "asset encode": [
      "output"
    ],
    "asset decode": [
      "output"
    ]
  },
  "schemas": [
    {
      "name": "project",
      "command": "gb schema project --json"
    },
    {
      "name": "envelope",
      "command": "gb schema envelope --json"
    },
    {
      "name": "patches",
      "command": "gb schema patches --json"
    },
    {
      "name": "assertions",
      "command": "gb schema assertions --json"
    },
    {
      "name": "debug",
      "command": "gb schema debug --json"
    },
    {
      "name": "game",
      "command": "gb schema game --json"
    },
    {
      "name": "suite",
      "command": "gb schema suite --json"
    },
    {
      "name": "build-receipt",
      "command": "gb schema build-receipt --json"
    }
  ],
  "manifest": {
    "filename": "gb-project.json",
    "format": "blast-gb-workspace",
    "version": 1,
    "kinds": [
      "source",
      "rom",
      "game"
    ]
  },
  "externalTools": {
    "assemblyBuild": [
      "rgbasm",
      "rgblink"
    ],
    "gameSpecBuild": [],
    "headlessRuntime": [],
    "graphicsConversion": [
      "rgbgfx"
    ]
  },
  "patchSchema": {
    "file": "array",
    "record": {
      "offset": "nonnegative integer file offset",
      "bytes": "byte array",
      "expected": "same-length original byte array (required unless --allow-unguarded)"
    }
  },
  "limitations": [
    "Disassembly cannot recover original symbols, comments, or code/data boundaries.",
    "Banked runtime breakpoints use mapped 16-bit addresses in any current bank.",
    "Runtime tests are bounded emulator evidence, not hardware certification.",
    "Runtime label references support bank-0 ROM0, WRAM0 and HRAM; ambiguous banked labels are rejected. Explicit numeric addresses retain current-bank semantics.",
    "GameSpec implements a bounded collection-game engine; source export permits custom assembly extensions.",
    "PNG conversion supports at most 4096 8x8 tiles; palette and attribute output are CGB-oriented."
  ]
}
