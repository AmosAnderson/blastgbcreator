{
  "name": "Blast GB Tools",
  "version": "0.4.1",
  "schemaVersion": 1,
  "commands": [
    "rom info",
    "rom verify",
    "rom diff",
    "rom patch",
    "asm compile",
    "asm decompile",
    "project init",
    "project import",
    "project resolve",
    "build",
    "run",
    "test",
    "debug",
    "capabilities",
    "schema",
    "version",
    "mcp serve",
    "init",
    "import",
    "inspect",
    "verify",
    "disassemble",
    "patch",
    "doctor",
    "project test",
    "game lint",
    "tiles export",
    "tiles import"
  ],
  "commandDefinitions": [
    {
      "name": "rom info",
      "description": "Inspect cartridge metadata and checksums.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": [],
      "aliases": [
        "inspect"
      ]
    },
    {
      "name": "rom verify",
      "description": "Validate cartridge size, logo, and checksums.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": [],
      "aliases": [
        "verify"
      ]
    },
    {
      "name": "rom diff",
      "description": "Compare two ROMs with bounded change previews.",
      "arguments": [
        {
          "name": "before",
          "type": "path",
          "required": true,
          "role": "input"
        },
        {
          "name": "after",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "json",
        "help",
        "patch-output",
        "overwrite"
      ],
      "sideEffects": [
        "write-patch-file-if-requested"
      ]
    },
    {
      "name": "rom patch",
      "description": "Apply expected-byte-guarded edits to a separate cartridge.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        },
        {
          "name": "patches",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "output",
        "overwrite",
        "fix-checksums",
        "allow-unguarded",
        "json",
        "help"
      ],
      "sideEffects": [
        "write-output-rom"
      ],
      "aliases": [
        "patch"
      ]
    },
    {
      "name": "asm compile",
      "description": "Assemble RGBDS source and emit ROM, symbols, and map.",
      "arguments": [
        {
          "name": "source",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "output",
        "overwrite",
        "fix-checksums",
        "json",
        "help",
        "provenance",
        "timeout-seconds"
      ],
      "sideEffects": [
        "execute-rgbds",
        "write-build-artifacts"
      ]
    },
    {
      "name": "asm decompile",
      "description": "Decode candidate instructions or export byte-exact RGBDS data.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "output",
        "overwrite",
        "offset",
        "count",
        "json",
        "help",
        "symbols",
        "label"
      ],
      "sideEffects": [
        "write-output-if-requested"
      ],
      "aliases": [
        "disassemble"
      ]
    },
    {
      "name": "project init",
      "description": "Create editable source or a built-in GameSpec project.",
      "arguments": [
        {
          "name": "directory",
          "type": "path",
          "required": true,
          "role": "output"
        }
      ],
      "options": [
        "name",
        "kind",
        "json",
        "help"
      ],
      "sideEffects": [
        "create-project-directory"
      ],
      "aliases": [
        "init"
      ]
    },
    {
      "name": "project import",
      "description": "Preserve a cartridge and export a byte-exact source project.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        },
        {
          "name": "directory",
          "type": "path",
          "required": true,
          "role": "output"
        }
      ],
      "options": [
        "name",
        "json",
        "help"
      ],
      "sideEffects": [
        "create-project-directory"
      ],
      "aliases": [
        "import"
      ]
    },
    {
      "name": "project resolve",
      "description": "Validate a project and resolve inputs and outputs without writing.",
      "arguments": [
        {
          "name": "project",
          "type": "path",
          "required": false,
          "role": "input"
        }
      ],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": [],
      "aliases": [
        "project info"
      ]
    },
    {
      "name": "build",
      "description": "Build a project, RGBDS source file, or GameSpec JSON.",
      "arguments": [
        {
          "name": "project",
          "type": "path",
          "required": false,
          "role": "input"
        }
      ],
      "options": [
        "output",
        "overwrite",
        "fix-checksums",
        "json",
        "help",
        "provenance",
        "timeout-seconds"
      ],
      "sideEffects": [
        "execute-rgbds-for-assembly",
        "write-build-artifacts"
      ]
    },
    {
      "name": "run",
      "description": "Execute a cartridge with bounded frames and optional assertions.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "frames",
        "memory",
        "assert",
        "buttons",
        "breakpoint",
        "max-instructions",
        "json",
        "help",
        "symbols",
        "until",
        "trace-capacity",
        "screenshot",
        "save-input",
        "save-output",
        "provenance",
        "overwrite"
      ],
      "sideEffects": [
        "execute-emulator",
        "write-capture-or-save-if-requested"
      ]
    },
    {
      "name": "test",
      "description": "Execute a cartridge and require an assertion file.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "frames",
        "memory",
        "assert",
        "buttons",
        "breakpoint",
        "max-instructions",
        "json",
        "help",
        "symbols",
        "until",
        "trace-capacity",
        "screenshot",
        "save-input",
        "save-output",
        "provenance",
        "overwrite"
      ],
      "sideEffects": [
        "execute-emulator",
        "write-capture-or-save-if-requested"
      ]
    },
    {
      "name": "debug",
      "description": "Execute a deterministic debugger command script.",
      "arguments": [
        {
          "name": "rom",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "script",
        "json",
        "help",
        "symbols",
        "screenshot",
        "save-input",
        "save-output",
        "provenance",
        "overwrite"
      ],
      "sideEffects": [
        "execute-emulator",
        "write-runtime-bus-if-requested",
        "write-capture-or-save-if-requested"
      ]
    },
    {
      "name": "capabilities",
      "description": "Discover versioned commands and contracts.",
      "arguments": [],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": []
    },
    {
      "name": "schema",
      "description": "List contracts or retrieve a JSON Schema by name.",
      "arguments": [
        {
          "name": "name",
          "type": "string",
          "required": false
        }
      ],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": []
    },
    {
      "name": "version",
      "description": "Print the installed toolkit version.",
      "arguments": [],
      "options": [
        "version",
        "json",
        "help"
      ],
      "sideEffects": [],
      "aliases": [
        "--version"
      ]
    },
    {
      "name": "mcp serve",
      "description": "Serve local command utilities over MCP stdio.",
      "arguments": [],
      "options": [
        "help"
      ],
      "sideEffects": [
        "serve-stdio"
      ]
    },
    {
      "name": "doctor",
      "description": "Report host/tool identities and perform a bundled runtime smoke check.",
      "arguments": [],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": [
        "execute-tool-version-probes",
        "execute-emulator"
      ]
    },
    {
      "name": "project test",
      "description": "Execute a bounded, named suite in independent emulator sessions.",
      "arguments": [
        {
          "name": "suite",
          "type": "path",
          "required": false,
          "role": "input"
        }
      ],
      "options": [
        "build",
        "overwrite",
        "timeout-seconds",
        "json",
        "help"
      ],
      "sideEffects": [
        "execute-emulator",
        "write-build-artifacts-if-requested",
        "execute-rgbds-for-assembly-build"
      ]
    },
    {
      "name": "game lint",
      "description": "Validate GameSpec JSON with field paths and map coordinates.",
      "arguments": [
        {
          "name": "game",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "json",
        "help"
      ],
      "sideEffects": []
    },
    {
      "name": "tiles export",
      "description": "Export raw 2bpp tiles as an opaque four-shade PNG sheet.",
      "arguments": [
        {
          "name": "tiles",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "output",
        "overwrite",
        "columns",
        "json",
        "help"
      ],
      "sideEffects": [
        "write-image"
      ]
    },
    {
      "name": "tiles import",
      "description": "Import a four-shade PNG sheet as raw 2bpp tiles.",
      "arguments": [
        {
          "name": "image",
          "type": "path",
          "required": true,
          "role": "input"
        }
      ],
      "options": [
        "output",
        "overwrite",
        "json",
        "help"
      ],
      "sideEffects": [
        "write-tiles"
      ]
    }
  ],
  "optionDefinitions": {
    "json": {
      "type": "boolean",
      "description": "Emit one versioned result envelope.",
      "default": false
    },
    "help": {
      "type": "boolean",
      "description": "Show command help.",
      "default": false
    },
    "version": {
      "type": "boolean",
      "description": "Print toolkit version."
    },
    "output": {
      "type": "path",
      "role": "output",
      "description": "Separate destination; never an input file."
    },
    "overwrite": {
      "type": "boolean",
      "default": false,
      "description": "Replace existing host outputs after validation."
    },
    "fix-checksums": {
      "type": "boolean",
      "default": false,
      "description": "Explicitly repair header/global checksums."
    },
    "allow-unguarded": {
      "type": "boolean",
      "default": false,
      "description": "Permit patch records without expected bytes."
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 256,
      "description": "Physical ROM byte offset."
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "default": 64,
      "description": "Maximum candidate instructions."
    },
    "name": {
      "type": "string",
      "description": "Project display name."
    },
    "kind": {
      "type": "string",
      "choices": [
        "source",
        "game"
      ],
      "default": "source"
    },
    "frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 60,
      "description": "70224-tick frame budgets."
    },
    "memory": {
      "type": "string",
      "description": "Mapped address:length ranges separated by commas; at most 65536 bytes total."
    },
    "assert": {
      "type": "path",
      "role": "input",
      "schema": "assertions"
    },
    "script": {
      "type": "path",
      "role": "input",
      "schema": "debug"
    },
    "buttons": {
      "type": "string",
      "description": "Comma-separated buttons held during execution.",
      "choices": [
        "up",
        "down",
        "left",
        "right",
        "A",
        "B",
        "start",
        "select"
      ]
    },
    "breakpoint": {
      "type": "address-or-symbol",
      "minimum": 0,
      "maximum": 65535,
      "description": "Mapped CPU program-counter address."
    },
    "max-instructions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000,
      "default": 1000000,
      "description": "Step budget while seeking a breakpoint."
    },
    "patch-output": {
      "type": "path",
      "role": "output",
      "description": "Write every equal-length ROM difference as complete guarded patches; previews remain bounded."
    },
    "screenshot": {
      "type": "path",
      "role": "output",
      "description": "Capture final 160x144 RGBA framebuffer as PNG, including failed assertion evidence."
    },
    "symbols": {
      "type": "path",
      "role": "input",
      "description": "Read RGBDS symbols; named breakpoints use mapped addresses in any active bank."
    },
    "label": {
      "type": "string",
      "description": "Select a ROM symbol for disassembly; requires symbols and excludes offset."
    },
    "until": {
      "type": "path",
      "role": "input",
      "schema": "assertions",
      "description": "Stop at the first matching after-step memory/register condition; excludes framebuffer checks."
    },
    "trace-capacity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024,
      "default": 0,
      "description": "Retain the most recent instruction snapshots."
    },
    "provenance": {
      "type": "boolean",
      "default": false,
      "description": "Include toolkit and engine/tool identities; build input hashes are observed after compilation."
    },
    "timeout-seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600,
      "default": 120,
      "description": "Deadline for each RGBDS build subprocess."
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128,
      "default": 1,
      "description": "Tile-sheet columns; must divide tile count exactly."
    },
    "save-input": {
      "type": "path",
      "role": "input",
      "description": "Load exact-sized raw battery RAM; timer saves and unsupported mappers are rejected."
    },
    "save-output": {
      "type": "path",
      "role": "output",
      "description": "Write final raw battery RAM to a separate staged file."
    },
    "build": {
      "type": "boolean",
      "default": false,
      "description": "Build the suite directory project before executing cases."
    }
  },
  "requiredOptions": {
    "rom patch": [
      "output"
    ],
    "test": [
      "assert"
    ],
    "debug": [
      "script"
    ],
    "tiles import": [
      "output"
    ],
    "tiles export": [
      "output"
    ]
  },
  "schemas": [
    {
      "name": "project",
      "command": "gb schema project --json"
    },
    {
      "name": "envelope",
      "command": "gb schema envelope --json"
    },
    {
      "name": "patches",
      "command": "gb schema patches --json"
    },
    {
      "name": "assertions",
      "command": "gb schema assertions --json"
    },
    {
      "name": "debug",
      "command": "gb schema debug --json"
    },
    {
      "name": "game",
      "command": "gb schema game --json"
    },
    {
      "name": "suite",
      "command": "gb schema suite --json"
    }
  ],
  "manifest": {
    "filename": "gb-project.json",
    "format": "blast-gb-workspace",
    "version": 1,
    "kinds": [
      "source",
      "rom",
      "game"
    ]
  },
  "externalTools": {
    "assemblyBuild": [
      "rgbasm",
      "rgblink"
    ],
    "gameSpecBuild": [],
    "headlessRuntime": []
  },
  "patchSchema": {
    "file": "array",
    "record": {
      "offset": "nonnegative integer file offset",
      "bytes": "byte array",
      "expected": "same-length original byte array (required unless --allow-unguarded)"
    }
  },
  "limitations": [
    "Disassembly cannot recover original symbols, comments, or code/data boundaries.",
    "Banked runtime breakpoints use mapped 16-bit addresses in any current bank.",
    "Runtime tests are bounded emulator evidence, not hardware certification.",
    "Raw battery saves exclude RTC data and support only explicitly validated battery-RAM mapper types.",
    "Tile PNG import supports non-interlaced 8-bit opaque grayscale/RGB/indexed/RGBA with shades 255,170,85,0."
  ]
}
