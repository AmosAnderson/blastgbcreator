{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blast-gb:schema:project:1",
  "title": "Blast GB project version 1",
  "type": "object",
  "required": [
    "format",
    "version",
    "name",
    "kind",
    "output"
  ],
  "properties": {
    "format": {
      "const": "blast-gb-workspace"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "rom",
        "source",
        "game"
      ]
    },
    "source": {
      "$ref": "#/$defs/path"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "description": "Assembly translation units in link order; mutually exclusive with source.",
      "items": { "$ref": "#/$defs/path" }
    },
    "includeDirectories": {
      "type": "array",
      "maxItems": 256,
      "description": "Existing relative workspace directories searched after the project and source directories.",
      "items": { "$ref": "#/$defs/path" }
    },
    "defines": {
      "type": "object",
      "maxProperties": 1024,
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": { "pattern": "[\\r\\n]" } },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096,
        "not": { "pattern": "[\\u0000\\r\\n]" }
      }
    },
    "receipt": {
      "$ref": "#/$defs/path"
    },
    "tests": {
      "$ref": "#/$defs/path"
    },
    "assets": {
      "type": "array",
      "maxItems": 256,
      "description": "PNG conversions staged before assembly and committed with the ROM.",
      "items": {
        "type": "object",
        "required": ["input", "output"],
        "properties": {
          "input": { "$ref": "#/$defs/path" },
          "output": { "$ref": "#/$defs/path" },
          "tilemap": { "$ref": "#/$defs/path" },
          "palette": { "$ref": "#/$defs/path" },
          "attrmap": { "$ref": "#/$defs/path" }
        }
      }
    },
    "game": {
      "$ref": "#/$defs/path"
    },
    "rom": {
      "$ref": "#/$defs/path"
    },
    "output": {
      "$ref": "#/$defs/path"
    },
    "patches": {
      "$ref": "#/$defs/path"
    },
    "fixChecksums": {
      "type": "boolean",
      "default": false
    },
    "romSize": {
      "type": "integer",
      "minimum": 336,
      "maximum": 8388608
    }
  },
  "allOf": [
    {
      "not": { "required": ["source", "sources"] }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "game"
          }
        }
      },
      "then": {
        "required": [
          "game"
        ],
        "properties": {
          "sources": false,
          "includeDirectories": { "maxItems": 0 },
          "defines": { "maxProperties": 0 },
          "assets": { "maxItems": 0 }
        }
      },
      "else": {
        "oneOf": [
          { "required": ["source"] },
          { "required": ["sources"] }
        ]
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path contained in the workspace. Runtime validation rejects traversal, absolute paths, and symlinks."
    }
  }
}
