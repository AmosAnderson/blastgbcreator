# Keep text checkouts consistent with .editorconfig on every platform.
* text=auto eol=lf

# Cartridge fixtures and the bundled emulator must remain byte-for-byte exact.
*.gb binary
*.gbc binary
*.wasm binary

# Graphics inputs and raw Game Boy assets must never undergo newline conversion.
*.png binary
*.2bpp binary
*.1bpp binary
*.bin binary
*.pal binary
*.tilemap binary
*.attrmap binary
